# The provider base_url you would normally pass to an OpenAI-compatible SDK.
# OpenAI:
UPSTREAM_BASE_URL=https://api.openai.com/v1
# DeepSeek commonly uses:
# UPSTREAM_BASE_URL=https://api.deepseek.com
# Ollama OpenAI-compatible local endpoint commonly uses:
# UPSTREAM_BASE_URL=http://host.docker.internal:11434/v1

UPSTREAM_API_KEY=replace_me

# Gateway
LLM_WAF_PORT=8080
MAX_BODY_BYTES=2000000

# Security defaults
REDACT_INPUTS=true
SCAN_OUTPUTS=true
REDACT_OUTPUTS=true
FAIL_CLOSED=false
BLOCKED_STATUS_CODE=403

# Audit and dashboard
AUDIT_LOG_PATH=var/audit/events.jsonl
DASHBOARD_LIMIT=50


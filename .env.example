# The provider base_url you would normally pass to an OpenAI-compatible SDK.
# OpenAI:
UPSTREAM_BASE_URL=https://api.openai.com/v1
# DeepSeek commonly uses:
# UPSTREAM_BASE_URL=https://api.deepseek.com
# Ollama OpenAI-compatible local endpoint commonly uses:
# UPSTREAM_BASE_URL=http://host.docker.internal:11434/v1

UPSTREAM_API_KEY=replace_me

# Gateway
LLM_WAF_PORT=8080
MAX_BODY_BYTES=2000000

# Optional gateway access control. Leave empty to allow anonymous local use.
# When enabled, clients should send X-LLM-WAF-Key: <key>.
GATEWAY_API_KEYS=
GATEWAY_API_KEY_HEADER=X-LLM-WAF-Key

# Optional local in-memory rate limit per gateway principal or anonymous client.
# 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Optional route policy file. The checked-in default preserves normal behavior
# while showing how to define per-route scan/redaction settings.
POLICY_PATH=config/policy.yaml

# Optional scanner rule file. If the file is missing or invalid, built-in
# Python fallback rules are used.
RULES_PATH=config/rules.yaml

# Optional pricing table for cost estimates in audit logs and dashboard.
PRICING_PATH=config/pricing.yaml

# Security defaults
REDACT_INPUTS=true
SCAN_OUTPUTS=true
REDACT_OUTPUTS=true
STREAM_SCAN_WINDOW_CHARS=4096
SEMANTIC_SCANNER_URL=
SEMANTIC_SCANNER_TIMEOUT_SECONDS=2.0
FAIL_CLOSED=false
BLOCKED_STATUS_CODE=403

# Audit and dashboard
AUDIT_LOG_PATH=var/audit/events.jsonl
DASHBOARD_LIMIT=50
